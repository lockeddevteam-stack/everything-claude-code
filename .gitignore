# Environment files
.env
.env.local
.env.*.local

# API keys
*.key
*.pem
secrets.json

# OS files
.DS_Store
Thumbs.db

# Editor files
.idea/
.vscode/
*.swp
*.swo

# Node
node_modules/

# Personal configs (if any)
personal/
private/

# Session templates (not committed)
examples/sessions/*.tmp

# Scratch scripts written by audit and sign-off agents while they work.
# They live in redesign/tests/ so Playwright resolves, are deleted when the
# agent finishes, and are never part of the suite. Committing one mid-run
# would put a half-written probe in the repo.
redesign/tests/zz-*.mjs
redesign/tests/_*.mjs

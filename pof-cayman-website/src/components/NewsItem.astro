---
/* Press coverage or award. Outlet, date, headline, link. */
import { formatDate } from '../lib/dates.js';
import Icon from './Icon.astro';
interface Props {
  item: { id: string; data: { title: string; outlet: string; date: Date; datePrecision: 'day' | 'month' | 'year'; url?: string; kind: 'coverage' | 'award' | 'milestone'; summary: string } };
  index?: number;
}
const { item, index = 0 } = Astro.props;
const { data } = item;
const KIND = { coverage: 'Coverage', award: 'Award', milestone: 'Milestone' };
---
<article class="news-item reveal" style={`--i: ${index % 6}`}>
  <p class="news-item__meta meta">
    <time class="tnum" datetime={data.date.toISOString().slice(0, data.datePrecision === 'year' ? 4 : data.datePrecision === 'month' ? 7 : 10)}>{formatDate(data.date, data.datePrecision)}</time>
    <span aria-hidden="true">·</span>
    <span>{data.outlet}</span>
    <span aria-hidden="true">·</span>
    <span>{KIND[data.kind]}</span>
  </p>
  <h3 class="news-item__title">
    {data.url ? <a href={data.url} rel="noopener">{data.title} <Icon name="arrow-up-right" /></a> : data.title}
  </h3>
  <p class="news-item__summary">{data.summary}</p>
</article>
<style>
  .news-item { display: grid; gap: var(--s-2); padding-block: var(--s-4); border-top: 1px solid var(--rule); }
  .news-item__meta { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .news-item__title { font-size: var(--fs-2); }
  .news-item__title a { color: inherit; text-decoration: none; }
  .news-item__title a:hover { text-decoration: underline; }
  .news-item__title .icon { display: inline; vertical-align: -0.1em; width: 0.8em; height: 0.8em; }
  .news-item__summary { max-width: 60ch; }
  @media (min-width: 64em) {
    .news-item { grid-template-columns: 12rem 1fr; column-gap: var(--s-5); }
    .news-item__meta { flex-direction: column; gap: var(--s-1); grid-row: 1 / 3; }
    .news-item__meta span[aria-hidden] { display: none; }
    .news-item__summary { grid-column: 2; }
  }
</style>

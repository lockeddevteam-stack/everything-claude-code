---
/* Verified numbers. Number, label, date or source. Never more than four. */
interface Stat { value: string; label: string; source: string }
interface Props { stats: readonly Stat[]; heading?: string }
const { stats, heading = 'Verified, with dates' } = Astro.props;
if (stats.length > 4) throw new Error('StatBand: four numbers maximum.');
---
<section class="stat-band surface-ocean" aria-labelledby="stat-heading">
  <div class="container">
    <h2 id="stat-heading" class="eyebrow stat-band__heading">{heading}</h2>
    <dl class="stat-band__list">
      {stats.map((s, i) => (
        <div class="stat reveal" style={`--i: ${i}`}>
          <dd class="stat__value tnum">{s.value}</dd>
          <dt class="stat__label">{s.label}</dt>
          <dd class="stat__source meta">{s.source}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
<style>
  .stat-band { padding-block: var(--s-6); }
  .stat-band__heading { margin-bottom: var(--s-5); }
  .stat-band__list { display: grid; gap: var(--s-5) var(--s-4); }
  .stat { display: grid; padding-top: var(--s-3); border-top: 1px solid var(--rule); }
  .stat__value { order: -1; }
  .stat__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-5);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
  .stat__label { font-size: var(--fs-1); margin-top: var(--s-2); }
  .stat__source { color: var(--text-muted); margin-top: var(--s-1); }
  @media (min-width: 40em) { .stat-band__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64em) {
    .stat-band { padding-block: var(--s-7); }
    .stat-band__list { grid-template-columns: 5fr 3fr 4fr 4fr; }
    .stat__value { font-size: var(--fs-6); }
    .stat:first-child .stat__value { font-size: 6rem; }
  }
</style>

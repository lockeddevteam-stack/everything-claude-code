---
/* Typographic wordmark. POF's official vector logo replaces this once supplied (see BLOCKERS.md). */
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<span class:list={['wordmark', cls]} translate="no">
  <span class="wordmark__top">Protect</span>
  <span class="wordmark__bottom">Our Future</span>
</span>
<style>
  .wordmark {
    display: inline-grid;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    font-size: var(--fs-1);
    color: inherit;
    text-transform: uppercase;
  }
  .wordmark__bottom { font-weight: 500; letter-spacing: 0; text-transform: none; }
</style>

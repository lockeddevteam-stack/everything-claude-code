---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Form from '../components/Form.astro';
import Icon from '../components/Icon.astro';
import { INTEGRATIONS, SITE } from '../lib/site';
---
<Base title="Contact" description="Contact Protect Our Future Cayman by form, email or Instagram. A student replies within two weeks.">
  <Hero compact eyebrow="Contact" title="Write to us.">
    <p class="lede">A student who runs POF reads every message and replies within two weeks. Press enquiries get a faster reply.</p>
  </Hero>
  <section class="section surface-paper">
    <div class="container grid">
      <div class="contact__direct flow">
        <h2>Direct</h2>
        <ul class="contact__list" role="list">
          <li><a href={`mailto:${SITE.email}`}><Icon name="mail" /> {SITE.email}</a></li>
          <li><a href={SITE.instagram.url} rel="noopener"><Icon name="instagram" /> {SITE.instagram.handle}</a></li>
          <li><a href={SITE.facebook.url} rel="noopener"><Icon name="facebook" /> {SITE.facebook.handle}</a></li>
        </ul>
        <p class="meta">Journalists: the <a href="/press">press page</a> has logo files, a boilerplate paragraph and key numbers with sources.</p>
      </div>
      <div class="contact__form">
        <h2 class="visually-hidden">Contact form</h2>
        <Form
          id="contact-form"
          endpoint={INTEGRATIONS.formspree.contact}
          subject="Message from the website"
          submitLabel="Send"
          successTitle="Thanks. We have your message."
          successBody="Someone from POF will reply within two weeks. If it is urgent, email us directly and put 'urgent' in the subject line."
        >
          <div class="field">
            <label for="c-name">Your name</label>
            <input id="c-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="c-email">Email</label>
            <input id="c-email" name="email" type="email" autocomplete="email" inputmode="email" required />
          </div>
          <div class="field">
            <label for="c-message">Message</label>
            <textarea id="c-message" name="message" required></textarea>
          </div>
        </Form>
      </div>
    </div>
  </section>
</Base>
<style>
  .contact__direct, .contact__form { grid-column: 1 / -1; }
  .contact__list { display: grid; gap: var(--s-1); }
  .contact__list a { display: inline-flex; align-items: center; gap: var(--s-2); min-height: var(--touch); font-family: var(--font-display); }
  @media (min-width: 64em) {
    .contact__direct { grid-column: 1 / 5; }
    .contact__form { grid-column: 6 / 13; }
  }
</style>

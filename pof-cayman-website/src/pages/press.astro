---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SloganBlock from '../components/SloganBlock.astro';
import Icon from '../components/Icon.astro';
import { SITE, STATS } from '../lib/site';
---
<Base title="Press" description="Press kit for Protect Our Future Cayman: logo files, boilerplate paragraph, key statistics with sources, and a media contact.">
  <Hero compact eyebrow="Press" title="Everything a journalist on deadline needs.">
    <p class="lede">Media contact: <a href={`mailto:${SITE.email}?subject=Press`}>{SITE.email}</a>. Put “press” in the subject line for a same-day reply where possible.</p>
  </Hero>

  <section class="section surface-paper" aria-labelledby="boiler-heading">
    <div class="container grid">
      <div class="press__lead flow">
        <h2 id="boiler-heading">Boilerplate</h2>
        <p class="meta">Use as is, or cut from the end.</p>
      </div>
      <div class="press__body flow">
        <p>{SITE.boilerplate}</p>
        <p class="meta">Short form: Protect Our Future (POF) is the largest youth-led environmental advocacy group in the Cayman Islands, founded by students in 2018.</p>
      </div>
    </div>
  </section>

  <section class="section surface-sand" aria-labelledby="facts-heading">
    <div class="container grid">
      <div class="press__lead flow">
        <h2 id="facts-heading">Key facts, with sources</h2>
        <SloganBlock as="p" size="md">Ignorance decides our future</SloganBlock>
      </div>
      <dl class="facts">
        {STATS.map((s) => (
          <div class="facts__row">
            <dt><span class="tnum facts__value">{s.value}</span> {s.label}</dt>
            <dd class="meta">{s.source}</dd>
          </div>
        ))}
        <div class="facts__row"><dt>Founded 2018 by four students at Cayman International School</dt><dd class="meta">POF</dd></div>
        <div class="facts__row"><dt>Chapters at Cayman International School, Cayman Prep and High School, First Baptist Christian School and St. Ignatius Catholic School</dt><dd class="meta">Generation Green, 2026</dd></div>
        <div class="facts__row"><dt>Represented the Cayman Islands at COP25 (Spain), COP26 (Glasgow), COP27 (Egypt) and COP28 (UAE)</dt><dd class="meta">UN Climate Change Conferences, 2019 to 2023</dd></div>
        <div class="facts__row"><dt>Dejea Lyons: Diana Award 2022; Diana Legacy Award March 2024, the first Caymanian, presented by Prince William; Planeteer Alliance ambassador; Captain Planet Young Superhero for Earth</dt><dd class="meta">The Diana Award; Planeteer Alliance; Captain Planet Foundation</dd></div>
        <div class="facts__row"><dt>Mission Blue partner, George Town Harbour Hope Spot</dt><dd class="meta">Mission Blue</dd></div>
        <div class="facts__row"><dt>Formal submissions on the National Conservation Act amendments and the National Energy Policy</dt><dd class="meta">POF</dd></div>
      </dl>
    </div>
  </section>

  <section class="section surface-paper" aria-labelledby="logo-heading">
    <div class="container grid">
      <div class="press__lead flow">
        <h2 id="logo-heading">Wordmark</h2>
        <p class="meta">Clear space of at least the height of the capital P on all sides. Do not recolour, stretch or place on a photograph without a solid block behind it.</p>
      </div>
      <div class="press__body flow">
        <div class="logo-preview">
          <img src="/press/pof-wordmark-ocean.svg" alt="Protect Our Future wordmark, ocean blue on paper" width="600" height="180" />
        </div>
        <ul class="downloads" role="list">
          <li><a href="/press/pof-wordmark-ocean.svg" download><Icon name="download" /> Wordmark, ocean on transparent (SVG)</a></li>
          <li><a href="/press/pof-wordmark-paper.svg" download><Icon name="download" /> Wordmark, paper on transparent (SVG)</a></li>
          <li><a href="/press/pof-wordmark-ocean.png" download><Icon name="download" /> Wordmark, ocean on transparent (PNG, 2400px)</a></li>
          <li><a href="/press/pof-wordmark-paper.png" download><Icon name="download" /> Wordmark, paper on transparent (PNG, 2400px)</a></li>
        </ul>
        <h3>Photography</h3>
        <p>Rights-cleared, captioned photographs of POF members and the banner series are supplied on request. Email the media contact with the outlet and the story. Photographs by Heidi Bassett Blair and Courtney Platt require credit and are cleared case by case.</p>
        <h3>Colours</h3>
        <ul class="swatches" role="list">
          <li><span class="swatch" style="background:#0B2E42"></span> Ocean #0B2E42</li>
          <li><span class="swatch" style="background:#3ED2C3"></span> Reef #3ED2C3</li>
          <li><span class="swatch" style="background:#F1EADC"></span> Sand #F1EADC</li>
          <li><span class="swatch" style="background:#2C4A3C"></span> Mangrove #2C4A3C</li>
        </ul>
      </div>
    </div>
  </section>
</Base>
<style>
  .press__lead, .press__body, .facts { grid-column: 1 / -1; }
  .press__lead { justify-items: start; }
  .facts { display: grid; gap: var(--s-3); }
  .facts__row { display: grid; gap: var(--s-1); padding-top: var(--s-3); border-top: 1px solid var(--c-ink); }
  .facts__row dt { font-family: var(--font-display); max-width: var(--measure); }
  .facts__value { font-weight: 700; }
  .logo-preview { padding: var(--s-5); background: var(--c-sand); border-radius: var(--r-2); }
  .logo-preview img { max-width: 24rem; width: 100%; height: auto; margin-inline: auto; }
  .downloads { display: grid; gap: var(--s-1); }
  .downloads a { display: inline-flex; align-items: center; gap: var(--s-2); min-height: var(--touch); font-family: var(--font-display); }
  .swatches { display: grid; gap: var(--s-2); font-family: var(--font-display); }
  .swatches li { display: flex; align-items: center; gap: var(--s-3); }
  .swatch { display: inline-block; width: 2.5rem; height: 2.5rem; border-radius: var(--r-1); border: 1px solid var(--rule); }
  @media (min-width: 64em) {
    .press__lead { grid-column: 1 / 5; }
    .press__body, .facts { grid-column: 6 / 13; }
  }
</style>

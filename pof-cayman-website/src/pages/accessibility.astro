---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { SITE } from '../lib/site';
---
<Base title="Accessibility" description="Protect Our Future Cayman's accessibility statement. The site is built to WCAG 2.1 AA. How to report a problem.">
  <Hero compact eyebrow="Accessibility" title="This site is built to be used by everyone.">
    <p class="lede">POF aims to meet WCAG 2.1 level AA across the whole site. If something is in your way, tell us and we will fix it.</p>
  </Hero>
  <section class="section surface-paper">
    <div class="container grid">
      <div class="a11y__body flow">
        <h2>What we do</h2>
        <ul>
          <li>Text and background colours meet a contrast ratio of at least 4.5:1, and 3:1 for large text and controls.</li>
          <li>Every page works with a keyboard alone. Focus is always visible. There are no keyboard traps.</li>
          <li>Every meaningful image has a written description. Decorative blocks are hidden from screen readers.</li>
          <li>Headings are in order on every page, with one main heading per page.</li>
          <li>Text can be resized to 200% without loss of content.</li>
          <li>Colour is never the only way information is shown. Campaign statuses use words and shapes as well.</li>
          <li>Animation is minimal and switched off when your device asks for reduced motion.</li>
          <li>Touch targets are at least 44 pixels with space between them.</li>
          <li>Forms have visible labels and describe errors in words.</li>
        </ul>
        <h2>Known limits</h2>
        <ul>
          <li>Our newsletter and donation pages are run by Mailchimp and Fygaro. We check their accessibility but do not control it.</li>
          <li>Older PDF documents linked from press coverage may not be tagged for screen readers.</li>
        </ul>
        <h2>Report a problem</h2>
        <p>Email <a href={`mailto:${SITE.email}?subject=Accessibility`}>{SITE.email}</a> with the page address and what happened. A student from POF will reply within two weeks and fix what we can.</p>
        <p class="meta">Statement reviewed September 2026.</p>
      </div>
    </div>
  </section>
</Base>
<style>
  .a11y__body { grid-column: 1 / -1; }
  @media (min-width: 64em) { .a11y__body { grid-column: 3 / 11; } }
</style>

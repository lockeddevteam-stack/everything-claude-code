---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Form from '../components/Form.astro';
import Icon from '../components/Icon.astro';
import { INTEGRATIONS, SITE } from '../lib/site';
---
<Base title="Get Involved" description="Volunteer with Protect Our Future in the Cayman Islands. Students, adults and families welcome. One short form, and we reply within two weeks.">
  <Hero compact eyebrow="Get Involved" title="Join POF.">
    <p class="lede">One short form, and a reply from a student who runs POF.</p>
  </Hero>
  <section class="section surface-paper" aria-labelledby="volunteer-heading">
    <div class="container grid">
      <div class="involve__lead flow">
        <h2 id="volunteer-heading">Volunteer</h2>
        <p>Tell us who you are and what you want to do. Cleanups, outings, painting banners, writing, photography: all of it is work someone has to do.</p>
        <ul class="involve__paths" role="list">
          <li><a class="link-arrow" href="/generation-green">Students: find or start a school chapter <Icon name="arrow-right" /></a></li>
          <li><a class="link-arrow" href="/support">Supporters: how giving works <Icon name="arrow-right" /></a></li>
        </ul>
      </div>
      <div class="involve__form">
        <Form
          id="volunteer-form"
          endpoint={INTEGRATIONS.formspree.volunteer}
          subject="Volunteer sign-up"
          submitLabel="Sign up"
          successTitle="Thanks. You are on the list."
          successBody="A POF member will reply within two weeks with the next event and how to get involved. If you are under 16, the reply will ask that a parent or guardian is aware."
        >
          <div class="field">
            <label for="v-name">Your name</label>
            <input id="v-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="v-email">Email</label>
            <input id="v-email" name="email" type="email" autocomplete="email" inputmode="email" required />
          </div>
          <div class="field">
            <label for="v-age">Age bracket</label>
            <select id="v-age" name="age_bracket" required>
              <option value="">Choose one</option>
              <option>Under 16</option>
              <option>16 to 17</option>
              <option>18 or over</option>
            </select>
            <span class="hint">Under 16s are welcome. We ask so a parent or guardian can be included.</span>
          </div>
          <div class="field">
            <label for="v-school">School, if you are a student</label>
            <input id="v-school" name="school" type="text" autocomplete="organization" />
          </div>
          <fieldset class="field">
            <legend>I am interested in</legend>
            <label class="choice"><input type="checkbox" name="interest" value="Cleanups and outings" /> Cleanups and outings</label>
            <label class="choice"><input type="checkbox" name="interest" value="Campaigns and writing" /> Campaigns and writing</label>
            <label class="choice"><input type="checkbox" name="interest" value="Photography and social media" /> Photography and social media</label>
            <label class="choice"><input type="checkbox" name="interest" value="Starting a school chapter" /> Starting a school chapter</label>
          </fieldset>
        </Form>
        <p class="meta involve__alt">Prefer email? <a href={`mailto:${SITE.email}?subject=Volunteer`}>{SITE.email}</a></p>
      </div>
    </div>
  </section>
</Base>
<style>
  .involve__lead, .involve__form { grid-column: 1 / -1; }
  .involve__lead { justify-items: start; }
  .involve__paths { display: grid; gap: var(--s-1); }
  .involve__alt { margin-top: var(--s-4); }
  @media (min-width: 64em) {
    .involve__lead { grid-column: 1 / 6; }
    .involve__form { grid-column: 7 / 13; }
  }
</style>

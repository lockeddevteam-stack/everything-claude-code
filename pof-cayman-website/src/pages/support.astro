---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SloganBlock from '../components/SloganBlock.astro';
import Icon from '../components/Icon.astro';
import { INTEGRATIONS, SITE } from '../lib/site';
const giveHref = INTEGRATIONS.fygaro || `mailto:${SITE.email}?subject=${encodeURIComponent('Donation to POF through Sustainable Cayman')}`;
const giveLabel = INTEGRATIONS.fygaro ? 'Give through Sustainable Cayman' : 'Email to give';
const tiers = [
  { amount: 'CI$25', label: 'Cleanup supplies', body: 'Gloves, bags and water for volunteers at one cleanup.' },
  { amount: 'CI$100', label: 'Banner and outreach materials', body: 'Sheets, paint and printing for a term of school chapter work.' },
  { amount: 'CI$500', label: 'Representation', body: 'Toward sending a student to speak for the islands at a conference or hearing.' },
];
---
<Base title="Support" description="How to give to POF, stated plainly: donations go through Sustainable Cayman (NPO-612), a registered non-profit. What the money pays for, and the overseas route.">
  <Hero compact eyebrow="Support" title="Give, and know exactly where it goes.">
    <p class="lede">POF is run by students and is not a registered non-profit. Donations are received on its behalf by {SITE.fiscalPartner.name}, a registered non-profit ({SITE.fiscalPartner.npo}). Here is how that works.</p>
  </Hero>

  <section class="section surface-paper" aria-labelledby="how-heading">
    <div class="container grid">
      <div class="give__lead flow">
        <h2 id="how-heading">How giving works</h2>
        <SloganBlock as="p" size="md">Protecting our future is protecting our past</SloganBlock>
      </div>
      <div class="give__body flow">
        <ol class="give__steps">
          <li><strong>Sustainable Cayman receives the gift.</strong> It is a registered non-profit in the Cayman Islands ({SITE.fiscalPartner.npo}) and a POF partner. Payments are made to Sustainable Cayman, earmarked for POF.</li>
          <li><strong>POF spends it on the work.</strong> Cleanup supplies, banner materials, chapter kits, and travel to represent the islands. Email us and we will tell you what a gift went to.</li>
          <li><strong>No tax deduction in Cayman.</strong> The Cayman Islands has no charitable tax deduction, so no receipt for tax purposes is issued locally. You will get a thank-you and a confirmation from Sustainable Cayman.</li>
        </ol>
        <p><a class="btn" href={giveHref}>{giveLabel} <Icon name={INTEGRATIONS.fygaro ? 'arrow-up-right' : 'mail'} /></a></p>
        {!INTEGRATIONS.fygaro && <p class="meta">We reply with the Sustainable Cayman payment link, usually within a week.</p>}
      </div>
    </div>
  </section>

  <section class="section surface-sand" aria-labelledby="tiers-heading">
    <div class="container grid">
      <div class="tiers__lead flow">
        <h2 id="tiers-heading">What a gift pays for</h2>
        <p>Any amount helps. These are the things POF spends money on most often.</p>
      </div>
      <ul class="tiers" role="list">
        {tiers.map((t, i) => (
          <li class:list={['tier', 'reveal', { 'tier--primary': i === 0 }]} style={`--i: ${i}`}>
            <span class="tier__amount tnum">{t.amount}</span>
            <span class="tier__label">{t.label}</span>
            <span class="tier__body">{t.body}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section surface-paper" aria-labelledby="overseas-heading">
    <div class="container grid">
      <div class="overseas__lead flow">
        <h2 id="overseas-heading">Giving from overseas</h2>
      </div>
      <div class="overseas__body flow">
        <p>Donors in the United States and elsewhere who want a tax-effective route give through an intermediary such as CAF America or GlobalGiving, the model the National Trust for the Cayman Islands uses.</p>
        {INTEGRATIONS.overseasGiving ? (
          <p><a class="btn btn--ghost" href={INTEGRATIONS.overseasGiving} rel="noopener">Give through the overseas route <Icon name="arrow-up-right" /></a></p>
        ) : (
          <p>POF does not have a live overseas page yet. Email <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Overseas donation')}`}>{SITE.email}</a> and we will arrange it with Sustainable Cayman.</p>
        )}
      </div>
    </div>
  </section>

  <section class="section surface-ocean" aria-labelledby="other-heading">
    <div class="container grid">
      <div class="other__lead flow">
        <h2 id="other-heading">Other ways to help</h2>
      </div>
      <ul class="other__list" role="list">
        <li><a href="/get-involved">Give time instead <Icon name="arrow-right" class="inline-icon" /></a></li>
        <li><a href="/press">Cover POF in the press <Icon name="arrow-right" class="inline-icon" /></a></li>
        <li><a href={SITE.instagram.url} rel="noopener">Follow {SITE.instagram.handle} on Instagram <Icon name="arrow-up-right" class="inline-icon" /></a></li>
      </ul>
    </div>
  </section>
</Base>
<style>
  .give__lead, .give__body, .tiers__lead, .tiers, .overseas__lead, .overseas__body, .other__lead, .other__list { grid-column: 1 / -1; }
  .give__lead { justify-items: start; }
  .give__steps { display: grid; gap: var(--s-3); padding-left: 1.25em; }
  .give__steps li { max-width: var(--measure); }
  .tiers { display: grid; gap: var(--s-4); }
  .tier { display: grid; gap: var(--s-1); padding-top: var(--s-3); border-top: 1px solid var(--c-ink); }
  .tier__amount { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-4); line-height: 1; letter-spacing: var(--tracking-display); }
  .tier__label { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-1); }
  .tier__body { max-width: 34ch; }
  .other__list { display: grid; gap: var(--s-1); }
  .other__list a { display: inline-flex; align-items: center; min-height: var(--touch); font-family: var(--font-display); }
  :global(.inline-icon) { display: inline; vertical-align: -0.2em; width: 1em; height: 1em; }
  @media (min-width: 64em) {
    .give__lead, .tiers__lead, .overseas__lead, .other__lead { grid-column: 1 / 5; }
    .give__body, .overseas__body, .other__list { grid-column: 6 / 12; }
    .tiers { grid-column: 6 / 13; grid-template-columns: 1fr 1fr; }
    .tier--primary { grid-column: 1 / -1; border-top-width: 3px; }
    .tier--primary .tier__amount { font-size: var(--fs-6); }
    .tier--primary .tier__body { max-width: 50ch; }
  }
</style>

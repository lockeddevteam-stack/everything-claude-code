---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SloganBlock from '../components/SloganBlock.astro';
import StatBand from '../components/StatBand.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import PathSelector from '../components/PathSelector.astro';
import EventCard from '../components/EventCard.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { SITE, STATS } from '../lib/site';
import { splitEvents } from '../lib/dates.js';

const campaigns = await getCollection('campaigns');
const featured = campaigns.find((c) => c.data.featured) ?? campaigns.sort((a, b) => a.data.order - b.data.order)[0];
const STATUS = { active: 'Active', won: 'Won', ongoing: 'Ongoing' };

const { upcoming } = splitEvents(await getCollection('events'));
const next = upcoming[0];

const paths = [
  { audience: 'Students', title: 'Join a chapter, or start one at your school', body: 'Four schools have POF chapters. Meetings count toward your ten community service hours.', href: '/generation-green', label: 'Find your school' },
  { audience: 'Volunteers', title: 'Come to the next cleanup', body: 'Adults and families welcome at cleanups and outings.', href: '/events', label: 'See upcoming events' },
  { audience: 'Supporters', title: 'Give, and know where it goes', body: 'Donations go through Sustainable Cayman, a registered non-profit.', href: '/support', label: 'How giving works' },
];
---
<Base title={SITE.name} description="The largest youth-led environmental advocacy group in the Cayman Islands. Founded by students in 2018. Around 180 members across four high schools.">
  <Hero eyebrow="Protect Our Future, Cayman Islands" title="Cayman's largest youth-led environmental advocacy group.">
    <SloganBlock as="p" slot="banner">Ignorance decides our future</SloganBlock>
    <p class="lede">Together, we have one goal: ensuring our grandchildren are able to experience nature like we have been able to.</p>
    <p><a class="btn" href="/get-involved">Join POF <Icon name="arrow-right" /></a></p>
  </Hero>

  <section class="section surface-paper" aria-labelledby="what-heading">
    <div class="container grid">
      <div class="what__lead">
        <h2 id="what-heading">What POF does</h2>
      </div>
      <div class="what__body flow reveal">
        <p class="lede">Four students at Cayman International School started Protect Our Future in 2018 as a campaign against overdevelopment. Today around 180 students across four high schools run it.</p>
        <p class="lede">The work has three parts: protecting natural habitats through legislation, educating the public on behaviour, and pushing for sustainable development.</p>
        <p class="lede">POF campaigned for years against cruise berthing in George Town Harbour. On 30 April 2025, 63.66% of referendum voters said no.</p>
        <p><a class="link-arrow" href="/about">Read the story from 2018 <Icon name="arrow-right" /></a></p>
      </div>
    </div>
  </section>

  <StatBand stats={STATS} />

  {featured && (
    <FeatureBlock
      eyebrow="Campaign"
      title={featured.data.title}
      status={{ label: STATUS[featured.data.status], kind: featured.data.status }}
      action={featured.data.action}
      image={featured.data.image}
      imageAlt={featured.data.imageAlt}
      tone="ocean"
      align="right"
      surface="paper"
    >
      <p>{featured.data.summary}</p>
      <p class="meta">{featured.data.statusNote}</p>
    </FeatureBlock>
  )}

  <PathSelector paths={paths} heading="Three ways to help" />

  <section class="cred surface-paper" aria-labelledby="cred-heading">
    <div class="container">
      <h2 id="cred-heading" class="visually-hidden">Recognition</h2>
      <p class="cred__list">
        <span>Represented the Cayman Islands at COP25, COP26, COP27 and COP28</span>
        <span>Diana Legacy Award, March 2024, the first to a Caymanian</span>
        <span>Mission Blue partner, George Town Harbour Hope Spot</span>
      </p>
    </div>
  </section>

  <section class="section surface-sand" aria-labelledby="next-heading">
    <div class="container grid">
      <div class="next__lead">
        <p class="eyebrow">Next event</p>
        <h2 id="next-heading">{next ? 'Come along' : 'Being scheduled'}</h2>
      </div>
      <div class="next__body">
        {next ? (
          <EventCard event={next} featured />
        ) : (
          <div class="stack-lg">
            <p class="lede">The next event is being scheduled. Dates go up here and on Instagram as soon as they are confirmed.</p>
            <Newsletter heading="Hear the date first" compact id="home-newsletter" short />
          </div>
        )}
      </div>
    </div>
  </section>
</Base>
<style>
  .what__lead { grid-column: 1 / -1; }
  .what__body { grid-column: 1 / -1; }
  .next__lead { grid-column: 1 / -1; }
  .next__body { grid-column: 1 / -1; }
  .cred { padding-block: var(--s-5); border-top: 1px solid var(--rule); }
  .cred__list { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); max-width: none; font-family: var(--font-display); font-size: var(--fs-small); color: var(--text-muted); }
  @media (min-width: 64em) {
    .what__lead { grid-column: 1 / 5; }
    .what__body { grid-column: 6 / 12; }
    .next__lead { grid-column: 1 / 4; }
    .next__body { grid-column: 5 / 13; }
  }
</style>

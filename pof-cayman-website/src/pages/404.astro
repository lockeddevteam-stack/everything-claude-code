---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" description="That page is not here. Find POF's chapters, events, campaigns and contact details." noindex>
  <Hero compact eyebrow="404" title="That page has moved, or never was.">
    <p class="lede">The old site had a few of those. Here are the four things people usually come for.</p>
  </Hero>
  <section class="section surface-paper">
    <div class="container">
      <h2 class="visually-hidden">Where to go next</h2>
      <ul class="lost" role="list">
        <li><a class="link-arrow lost__link" href="/generation-green">Join or start a school chapter <Icon name="arrow-right" /></a></li>
        <li><a class="link-arrow lost__link" href="/events">Upcoming events <Icon name="arrow-right" /></a></li>
        <li><a class="link-arrow lost__link" href="/support">How to give <Icon name="arrow-right" /></a></li>
        <li><a class="link-arrow lost__link" href="/contact">Contact POF <Icon name="arrow-right" /></a></li>
      </ul>
    </div>
  </section>
</Base>
<style>
  .lost { display: grid; gap: var(--s-1); }
  .lost__link { font-size: var(--fs-2); }
</style>

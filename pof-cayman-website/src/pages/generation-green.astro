---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SloganBlock from '../components/SloganBlock.astro';
import ChapterCard from '../components/ChapterCard.astro';
import Form from '../components/Form.astro';
import { INTEGRATIONS } from '../lib/site';

const chapters = (await getCollection('chapters')).sort((a, b) => a.data.order - b.data.order);
const active = chapters.filter((c) => c.data.status === 'active');
const forming = chapters.filter((c) => c.data.status === 'forming');
---
<Base title="Generation Green" description="Generation Green is POF's programme for student-led chapters in Cayman schools. Four chapters are active. Find yours, or start one.">
  <Hero compact eyebrow="Generation Green" title="A POF chapter in every school.">
    <p class="lede">Generation Green is how POF grows: an official student-led chapter in each school, run by students, with meetings that count toward your community service hours.</p>
  </Hero>

  <section class="section surface-paper" aria-labelledby="how-heading">
    <div class="container grid">
      <div class="how__lead flow">
        <h2 id="how-heading">How a chapter works</h2>
        <SloganBlock as="p" size="md">Mangroves secure our future</SloganBlock>
        <p class="meta">Painted on a POF banner. Every chapter picks a campaign like this one to work on each term.</p>
      </div>
      <ol class="how__steps" role="list">
        <li class="reveal">
          <h3>A student leads it</h3>
          <p>Each chapter has a Chapter Lead, a student at that school. The Chapters Lead at POF supports them and connects the chapters to each other.</p>
        </li>
        <li class="reveal" style="--i: 1">
          <h3>It meets at school</h3>
          <p>Chapters meet on campus with a teacher's knowledge. Meeting times are set each term and listed below once confirmed.</p>
        </li>
        <li class="reveal" style="--i: 2">
          <h3>It takes on one campaign at a time</h3>
          <p>A term's project might be a beach cleanup, a reef-safe sunscreen drive, or a letter to the Department of Environment. Small, finished, and counted.</p>
        </li>
        <li class="reveal" style="--i: 3">
          <h3>Hours count</h3>
          <p>Cayman students must complete a minimum of ten community service hours. Chapter meetings and POF events count.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section surface-sand" aria-labelledby="directory-heading">
    <div class="container">
      <h2 id="directory-heading">Chapter directory</h2>
      <p class="muted directory__note">Updated each school term by the Chapters Lead.</p>
      <ul class="directory" role="list">
        {active.map((c, i) => <li><ChapterCard chapter={c} index={i} /></li>)}
      </ul>
      {forming.length > 0 && (
        <div class="forming">
          <h3>Forming</h3>
          <p>POF has contacts at these schools and is helping students there start a chapter.</p>
          <ul class="forming__list" role="list">
            {forming.map((c) => <li>{c.data.school}</li>)}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="section surface-paper" aria-labelledby="start-heading" id="start">
    <div class="container grid">
      <div class="start__lead flow">
        <h2 id="start-heading">Start a chapter</h2>
        <p>If your school is not listed, you can be the one who starts it. Tell us who you are and we will reply within two weeks with what happens next.</p>
        <p>Teachers and parents are welcome to write on a student's behalf.</p>
      </div>
      <div class="start__form">
        <Form
          id="chapter-form"
          endpoint={INTEGRATIONS.formspree.chapter}
          subject="Start a chapter"
          submitLabel="Ask to start a chapter"
          successTitle="Thanks. We have your message."
          successBody="The Chapters Lead will reply within two weeks to set up a first conversation. If you are under 16, we will ask that a parent, guardian or teacher is part of it."
        >
          <div class="field">
            <label for="ch-name">Your name</label>
            <input id="ch-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="ch-email">Email</label>
            <input id="ch-email" name="email" type="email" autocomplete="email" inputmode="email" required />
          </div>
          <div class="field">
            <label for="ch-school">School</label>
            <input id="ch-school" name="school" type="text" autocomplete="organization" required />
          </div>
          <div class="field">
            <label for="ch-role">I am a</label>
            <select id="ch-role" name="role" required>
              <option value="">Choose one</option>
              <option>Student</option>
              <option>Teacher</option>
              <option>Parent or guardian</option>
            </select>
          </div>
          <div class="field">
            <label for="ch-age">Age bracket</label>
            <select id="ch-age" name="age_bracket" required>
              <option value="">Choose one</option>
              <option>Under 16</option>
              <option>16 to 17</option>
              <option>18 or over</option>
            </select>
            <span class="hint">We ask so we know whether a parent or guardian should be included.</span>
          </div>
        </Form>
      </div>
    </div>
  </section>
</Base>
<style>
  .how__lead, .how__steps, .start__lead, .start__form { grid-column: 1 / -1; }
  .how__lead { justify-items: start; }
  .how__steps { display: grid; gap: var(--s-4); counter-reset: step; }
  .how__steps li { display: grid; gap: var(--s-2); padding-top: var(--s-3); border-top: 1px solid var(--c-ink); counter-increment: step; }
  .how__steps h3::before { content: counter(step, decimal-leading-zero) "  "; font-weight: 500; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .directory__note { margin-top: var(--s-2); }
  .directory { display: grid; gap: var(--s-5); margin-top: var(--s-5); }
  .forming { margin-top: var(--s-6); padding-top: var(--s-4); border-top: 1px solid var(--c-ink); display: grid; gap: var(--s-2); }
  .forming__list { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); font-family: var(--font-display); font-weight: 600; }
  @media (min-width: 40em) { .directory { grid-template-columns: 1fr 1fr; column-gap: var(--s-5); } }
  @media (min-width: 64em) {
    .how__lead { grid-column: 1 / 6; }
    .how__steps { grid-column: 7 / 13; }
    .start__lead { grid-column: 1 / 5; }
    .start__form { grid-column: 6 / 13; }
  }
</style>

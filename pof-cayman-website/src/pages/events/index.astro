---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import SloganBlock from '../../components/SloganBlock.astro';
import EventCard from '../../components/EventCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import Icon from '../../components/Icon.astro';
import { splitEvents } from '../../lib/dates.js';

const { upcoming, past } = splitEvents(await getCollection('events'));
---
<Base title="Events" description="Upcoming Protect Our Future cleanups, mangrove outings and the Youth Climate March in Grand Cayman. Dates, locations and how to sign up.">
  <Hero compact eyebrow="Events" title={upcoming.length ? 'Coming up' : 'The next one is being scheduled'}>
    <p class="lede">Cleanups, outings and the Youth Climate March. Everyone is welcome. Students earn community service hours.</p>
  </Hero>

  <section class="section surface-paper" aria-labelledby="upcoming-heading">
    <div class="container grid">
      <div class="events__lead flow">
        <h2 id="upcoming-heading">{upcoming.length ? `${upcoming.length === 1 ? 'One event' : `${upcoming.length} events`} scheduled` : 'Nothing scheduled yet'}</h2>
        <SloganBlock as="p" size="md">Show up for the island</SloganBlock>
        <p class="meta">Past events leave this page on their own the day after they happen.</p>
      </div>
      <div class="events__list" data-events-list>
        {upcoming.length ? (
          upcoming.map((e, i) => <EventCard event={e} headingLevel="h3" featured={i === 0} />)
        ) : null}
        <div class="events__empty stack-lg" data-events-empty hidden={upcoming.length > 0}>
          <p class="lede">Dates go up here and on Instagram as soon as they are confirmed. Leave your email and you will hear first.</p>
          <Newsletter heading="Hear the next date first" compact id="events-newsletter" />
        </div>
      </div>
    </div>
  </section>

  {past.length > 0 && (
    <nav class="section--tight surface-sand" aria-label="Past events">
      <div class="container"><a href="/events/archive">{past.length} past {past.length === 1 ? 'event' : 'events'} <Icon name="arrow-right" class="inline-icon" /></a></div>
    </nav>
  )}
</Base>
<style>
  .events__lead, .events__list { grid-column: 1 / -1; }
  .events__lead { justify-items: start; }
  :global(.inline-icon) { display: inline; vertical-align: -0.2em; width: 1em; height: 1em; }
  @media (min-width: 64em) {
    .events__lead { grid-column: 1 / 5; }
    .events__list { grid-column: 6 / 13; }
  }
</style>
<script>
  // Belt and braces: if the site has not been rebuilt since an event passed,
  // hide it here too. Cayman is UTC-5 with no daylight saving.
  const today = new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 10);
  const list = document.querySelector('[data-events-list]');
  if (list) {
    let visible = 0;
    for (const el of list.querySelectorAll<HTMLElement>('[data-event-date]')) {
      if ((el.dataset.eventDate || '') < today) el.hidden = true; else visible++;
    }
    const empty = list.querySelector<HTMLElement>('[data-events-empty]');
    if (empty && visible === 0) empty.hidden = false;
  }
</script>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { splitEvents, formatRange } from '../../lib/dates.js';
const { past } = splitEvents(await getCollection('events'));
---
<Base title="Past events" description="Archive of past Protect Our Future events in the Cayman Islands." noindex>
  <Hero compact eyebrow="Events" title="Past events">
    <p class="lede">What POF has done, most recent first. <a href="/events">See what is coming up</a>.</p>
  </Hero>
  <section class="section surface-paper">
    <div class="container">
      <h2 class="visually-hidden">All past events</h2>
      {past.length ? (
        <ul class="archive" role="list">
          {past.map((e) => (
            <li class="archive__item">
              <span class="meta tnum">{formatRange(e.data.date, e.data.endDate)}</span>
              <a href={`/events/${e.id}`}>{e.data.title}</a>
              <span class="meta">{e.data.location}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p>No past events are listed yet.</p>
      )}
    </div>
  </section>
</Base>
<style>
  .archive { display: grid; }
  .archive__item { display: grid; gap: var(--s-1); padding-block: var(--s-3); border-top: 1px solid var(--rule); font-family: var(--font-display); }
  @media (min-width: 40em) { .archive__item { grid-template-columns: 11rem 1fr 1fr; gap: var(--s-4); align-items: baseline; } }
</style>

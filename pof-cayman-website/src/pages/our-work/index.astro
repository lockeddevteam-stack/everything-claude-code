---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import SloganBlock from '../../components/SloganBlock.astro';
import FeatureBlock from '../../components/FeatureBlock.astro';
import Icon from '../../components/Icon.astro';

const all = (await getCollection('campaigns')).sort((a, b) => a.data.order - b.data.order);
const featured = all.find((c) => c.data.featured) ?? all[0];
const rest = all.filter((c) => c.id !== featured.id);
const STATUS = { active: 'Active', won: 'Won', ongoing: 'Ongoing' };
---
<Base title="Our Work" description="POF's seven campaigns and where each stands: cruise berthing, mangroves, single-use plastics, reef-safe sunscreen, heritage homes, Seven Mile Beach.">
  <Hero compact eyebrow="Our Work" title="Seven campaigns, and where each one stands.">
    <p class="lede">Every campaign here has a status: active, won or ongoing. POF updates them each school term and does not hide the ones that are unresolved.</p>
  </Hero>

  <FeatureBlock
    eyebrow="Won"
    title={featured.data.title}
    status={{ label: STATUS[featured.data.status], kind: featured.data.status }}
    action={{ label: 'Read the full story', href: `/our-work/${featured.id}` }}
    image={featured.data.image}
    imageAlt={featured.data.imageAlt}
    tone="ocean"
    align="left"
    surface="paper"
  >
    <p>{featured.data.summary}</p>
    <p class="meta">{featured.data.statusNote}</p>
  </FeatureBlock>

  <section class="section surface-sand" aria-labelledby="campaigns-heading">
    <div class="container">
      <div class="campaigns__head">
        <h2 id="campaigns-heading">The rest of the work</h2>
        <SloganBlock as="p" size="md">Our future is not single-use</SloganBlock>
      </div>
      <ul class="campaigns" role="list">
        {rest.map((c, i) => (
          <li class="campaign reveal" style={`--i: ${i % 6}`}>
            <div class="campaign__head">
              <h3 class="campaign__title"><a href={`/our-work/${c.id}`}>{c.data.title}</a></h3>
              <span class:list={['chip', `chip--${c.data.status}`]}>{STATUS[c.data.status]}</span>
            </div>
            <div class="campaign__body">
              <p>{c.data.summary}</p>
              <p class="meta">{c.data.statusNote}</p>
              <a class="campaign__link" href={`/our-work/${c.id}`}>Read POF's position <Icon name="arrow-right" /></a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .campaigns__head { display: grid; gap: var(--s-3); margin-bottom: var(--s-5); justify-items: start; }
  .campaigns { display: grid; }
  .campaign { display: grid; gap: var(--s-3); padding-block: var(--s-4); border-top: 1px solid var(--c-ink); }
  .campaign__head { display: grid; gap: var(--s-2); justify-items: start; align-content: start; }
  .campaign__title { font-size: var(--fs-2); }
  .campaign__title a { color: inherit; text-decoration: none; }
  .campaign__title a:hover { text-decoration: underline; }
  .campaign__body { display: grid; gap: var(--s-2); }
  .campaign__link { display: inline-flex; align-items: center; gap: var(--s-1); min-height: var(--touch); font-family: var(--font-display); }
  @media (min-width: 64em) {
    .campaigns__head { grid-template-columns: 5fr 7fr; align-items: end; }
    .campaign { grid-template-columns: 5fr 7fr; gap: var(--s-5); padding-block: var(--s-5); }
  }
</style>
